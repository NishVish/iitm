RewriteEngine On

# 1️⃣ Proxy API calls to Node
RewriteCond %{REQUEST_URI} ^/iitm/node/api/
RewriteRule ^api/(.*)$ http://127.0.0.1:8000/api/$1 [P,L]

# 2️⃣ Serve existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3️⃣ React SPA fallback (offline-safe)
RewriteRule ^.*$ frontend/build/index.html [L]